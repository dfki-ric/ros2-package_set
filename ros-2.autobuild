import_package "slam/g2o" do |pkg|
    pkg.depends_on "suitesparse"
end

colcon_package "pclomp", move_to: "slam"
colcon_package "nabo", move_to: "slam"

colcon_package "pointmatcher", move_to: "slam" do |pkg|
    pkg.depends_on "nabo"
end

colcon_import_package "slam/slam3d", libname: "slam3d"
import_package "slam3d_octomap"
move_package "slam3d_octomap", "slam"

colcon_package "slam3d_ros2", move_to: "slam"

not_on ["ubuntu", "22.04"] do
    colcon_package "slam/vdb_mapping"
end
remove_from_default 'slam/vdb_mapping'

colcon_package "gazebo_ros2_control/gazebo_ros2_control", importdir: "gazebo_ros2_control"
colcon_package "gazebo_ros2_control/gazebo_ros2_control_demos", importdir: "gazebo_ros2_control"

remove_from_default 'gazebo_ros2_control/gazebo_ros2_control'
remove_from_default 'gazebo_ros2_control/gazebo_ros2_control_demos'

colcon_package "interaction/libraries/robot_remote_control"
metapackage "robot_remote_control", "interaction/libraries/robot_remote_control"

colcon_package "ugv_nav4d_ros2", move_to: "planning"

colcon_package "ground_segmentation", move_to: "perception"
colcon_package "ground_segmentation_ros2", move_to: "perception" do |pkg|
    pkg.depends_on "ament_lint_auto"
    pkg.depends_on "ament_lint_common"
end

colcon_package "nav2_ground_consistency_costmap_plugin", move_to: "navigation"

osdeps = Autoproj.workspace.os_package_resolver

# plotjuggler is no longer released for rolling
if osdeps.availability_of("plotjuggler") != Autoproj::OSPackageResolver::AVAILABLE
    # optional for robot_remote_control (its PlotJuggler plugin is skipped without it)
    osdeps.add_entries({ "plotjuggler" => "ignore" }, file: __FILE__)
end

# nav2 is not released for every ROS distribution (e.g. not for rolling, docker images instead:
# https://discourse.openrobotics.org/t/rfi-would-you-use-nav2-rolling-binaries/37490)
# TODO build nav2 from source in that case?
if osdeps.availability_of("nav2_costmap_2d") != Autoproj::OSPackageResolver::AVAILABLE
    Autoproj.warn "nav2_costmap_2d is not available for ROS_DISTRO #{Autoproj.config.get('ROS_DISTRO')}, " \
                  "ignoring nav2_ground_consistency_costmap_plugin"
    Autoproj.manifest.ignore_package "nav2_ground_consistency_costmap_plugin"
end
if osdeps.availability_of("nav2_msgs") != Autoproj::OSPackageResolver::AVAILABLE
    # ugv_nav4d_ros2 builds without it (only some of its scripts use it)
    osdeps.add_entries({ "nav2_msgs" => "ignore" }, file: __FILE__)
end
